NVR_IP=192.168.1.100
NVR_RTSP_PORT=554
NVR_USER=troque_por_seu_usuario
NVR_PASSWORD=troque_por_sua_senha
NVR_STREAM=1
CAMERA_COUNT=4

#Nome das Câmeras
CAMERA_1_NAME=Câmera 1
CAMERA_2_NAME=Câmera 2
CAMERA_3_NAME=Câmera 3
CAMERA_4_NAME=Câmera 4
# Usados quando CAMERA_COUNT=8
CAMERA_5_NAME=Câmera 5
CAMERA_6_NAME=Câmera 6
CAMERA_7_NAME=Câmera 7
CAMERA_8_NAME=Câmera 8

SUPPRESS_CONNECTION_ERRORS=off
CONNECTION_ATTEMPTS=3

# Configurações opcionais da interface
WINDOW_WIDTH=1280
WINDOW_HEIGHT=720
WINDOW_SCALE=0.92
# contain mostra o quadro inteiro; cover preenche o painel e recorta as bordas
IMAGE_FIT=contain
UI_FPS=15
AUDIO_VOLUME=50
# Opcional: caminho completo do ffplay quando ele não estiver no PATH
# FFPLAY_PATH=/opt/homebrew/bin/ffplay
RECONNECT_SECONDS=3.0
RECONNECT_MAX_SECONDS=60.0
